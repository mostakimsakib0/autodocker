# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Docking run artifacts
*/ligands/
*/results/
*/out/
*_out/
*.pdbqt
*.sdf
*.log

# node
node_modules/
pnpm-lock.yaml
# ...except the NGL lockfile the image build installs from (--frozen-lockfile)
!tools/ngl/pnpm-lock.yaml

# Submodules are cloned lazily; keep the tracker but never vendor trees
tools/*/repo/

# keep helper scripts
!/scripts/

# Committed test and CI smoke fixtures (*.pdbqt/*.sdf are ignored above)
!tests/data/**
!/.github/smoke/**

# Vendored fpocket was removed; never re-add it (build via tools/fpocket submodule)
/fpocket/

# Local working docs, kept out of the remote repo
AUDIT_REPORT.md
ROADMAP_10_OF_10.md
